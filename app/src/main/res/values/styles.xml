<resources>
    <color name="ink">#05060B</color>
    <style name="Theme.AsistentePro" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorAccent">#819FFF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AureaSession" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#9CB4FF</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
